PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/v_agency
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Frontend URL (used in email links and OAuth redirects)
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ENABLE_JOBS=true

# First admin created by `npm run seed`
ADMIN_EMAIL=admin@vagency.com
ADMIN_PASSWORD=admin12345

# SMTP for deadline alerts / client approval emails (logs to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="V Agency <no-reply@yourdomain.com>"

# Google Drive: service account JSON (raw or base64) with access to the Shared Drive
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_USER=
GOOGLE_SHARED_DRIVE_ID=

# Google Calendar: OAuth client for employees connecting their calendars
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback
